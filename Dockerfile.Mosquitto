FROM arm64v8/debian:trixie-slim

LABEL maintainer="docker@intrepid.de"

ENV MOSQUITTOVERSION=<<MOSQUITTOVERSION>> \
    USERID=9002

# based on https://github.com/fstehle/docker-rpi-mosquitto
COPY push-mqtt.sh /opt/push-mqtt.sh

RUN passwd -l root ; \
    apt-get update && \
    apt-get install -yq \
      bash \
      apt-transport-https \
      curl \
#      wget \
      gnupg \
      ca-certificates \
      libcjson1 \
      openssl \
      bc \
      build-essential \
      libssl-dev \
      libc-ares-dev \
      libwebsockets-dev \
      libcjson-dev && \
    mkdir -p /usr/src ; \
    cd /usr/src && \
    curl -fSL --retry 5 --retry-delay 5 --retry-all-errors -o mosquitto-2.1.2.tar.gz https://mosquitto.org/files/source/mosquitto-2.1.2.tar.gz && \
#    wget --tries=5 --retry-connrefused --waitretry=5 https://mosquitto.org/files/source/mosquitto-${MOSQUITTOVERSION}.tar.gz && \
    tar xzvf mosquitto-${MOSQUITTOVERSION}.tar.gz && \
    cd /usr/src/mosquitto-${MOSQUITTOVERSION}/libcommon && \
    make WITH_DOCS=no && \
    cd /usr/src/mosquitto-${MOSQUITTOVERSION}/lib && \
    make WITH_DOCS=no && \
    make install && \
    ldconfig && \
    cd /usr/src/mosquitto-${MOSQUITTOVERSION}/client && \
    make WITH_DOCS=no && \
    make install && \
    cd / && \
    apt-get remove -yq \
      build-essential \
      libssl-dev \
      libc-ares-dev \
      libwebsockets-dev \
      libcjson-dev \
      curl && \
#      wget && \
    apt-get clean -y && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/src/* && \
    chmod 755 /opt/push-mqtt.sh

# Run the command on container startup
CMD /opt/push-mqtt.sh

